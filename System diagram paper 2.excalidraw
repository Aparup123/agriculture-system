    {
      "id": "61t_ihE8H3jsHL3xXojaV",
      "type": "text",
      "x": 979.4694687979556,
      "y": 219.7937006269185,
      "width": 232.01302083333334,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
