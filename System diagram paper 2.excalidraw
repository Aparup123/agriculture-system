      "version": 190,
      "versionNonce": 87309171,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767366339172,
      "link": null,
      "locked": false,
      "text": "Long Distance\nCommunication using\nLoRA",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Long Distance Communication using LoRA",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "06zGYUVd-WHeGSr5xwHW1",
      "type": "text",
      "x": 811.1196921639495,
      "y": 693.453921896944,
      "width": 495.9596252441406,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 214521941,
      "version": 432,
      "versionNonce": 203554045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767367211652,
      "link": null,
      "locked": false,
      "text": "Features\n1. UI will be very easy to use for the farmers\n2. No internet connectivity will be required\n3. Edge computing will be used to get insights\n4. Long Range communication by using LoRA module\n5. Actuation from remote area\n6. Add RAG",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Features\n1. UI will be very easy to use for the farmers\n2. No internet connectivity will be required\n3. Edge computing will be used to get insights\n4. Long Range communication by using LoRA module\n5. Actuation from remote area\n6. Add RAG",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VOiWd08qVfpxPbGKg7qrG",
      "type": "text",
      "x": 334.2676562795891,
      "y": 675.5774961042404,
      "width": 436.4596862792969,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 920642037,
      "version": 164,
      "versionNonce": 685654459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767194739081,
      "link": null,
      "locked": false,
      "text": "Research GAP\n❌ What is missing in most papers:\nFarm → Home separation\nBidirectional actuator control over LoRa\nEdge AI placed at farmer’s home (not cloud)\nOffline-first operation\nFarmer usability as a design goal\nEvaluation under network absence",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Research GAP\n❌ What is missing in most papers:\nFarm → Home separation\nBidirectional actuator control over LoRa\nEdge AI placed at farmer’s home (not cloud)\nOffline-first operation\nFarmer usability as a design goal\nEvaluation under network absence",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bRqWaA8pTlVBWz8un2lwt",
      "type": "text",
      "x": 332.54745383294573,
      "y": 902.9610882352699,
      "width": 265.2633446125678,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2F",
      "roundness": null,
      "seed": 708108275,
      "version": 512,
      "versionNonce": 1487185619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767366617928,
      "link": null,
      "locked": false,
      "text": "List of products\n1. Arduino Uno\n2. DHT \n3. Soil Moisture\n4. Light Sensor\n5. Ph sensor\n6. Water Pump\n7. LoRA module(R)\n8. Battery\n9. R pi\n10. Screen Touch Display\n11. Wires jumper",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List of products\n1. Arduino Uno\n2. DHT \n3. Soil Moisture\n4. Light Sensor\n5. Ph sensor\n6. Water Pump\n7. LoRA module(R)\n8. Battery\n9. R pi\n10. Screen Touch Display\n11. Wires jumper",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "66MxX_81X_UISPg-2n1XR",
      "type": "text",
      "x": 811.1454050841048,
      "y": 909.4102139909684,
      "width": 642.0519142231997,
      "height": 300,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 1111647187,
      "version": 912,
      "versionNonce": 936709085,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767367569012,
      "link": null,
      "locked": false,
      "text": "List of Works\n1. Collect Data From Sensors\n2. Send Data from field to home via LoRA module\n3. Run the pump according to the incoming data from the HOME\n4. Receive Data Sent from the field using R pi\n5. Create a UI to display the Data in the dashboard(R)\n6. Create an interface to send the actuation signal from home\nto the field\n7. Implement an AI model locally inside the RPi to gain insight\nfrom the received from the field and show it to the UI\n8. Create a mobile application\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List of Works\n1. Collect Data From Sensors\n2. Send Data from field to home via LoRA module\n3. Run the pump according to the incoming data from the HOME\n4. Receive Data Sent from the field using R pi\n5. Create a UI to display the Data in the dashboard(R)\n6. Create an interface to send the actuation signal from home to the field\n7. Implement an AI model locally inside the RPi to gain insight from the received from the field and show it to the UI\n8. Create a mobile application\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
